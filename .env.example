# Runtime secrets are configured through Sites. Never put a real key in this file.
# For local preview, put secrets in the ignored .dev.vars file.
GEMINI_API_KEY=
# Optional Gemini model overrides. Gemini keys are sent only to Google's API.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_AUDIO_MODEL=gemini-3.8-flash-tts

# Optional 9Router deployment. Use YOUR publicly reachable HTTPS instance.
# Root URLs are normalized to /v1; a URL already ending in /v1 is preserved.
# No public 9Router URL or universal model ID is assumed.
NINEROUTER_BASE_URL=
# A router key is required. It is sent only to the trusted server Base URL.
NINEROUTER_API_KEY=
NINEROUTER_TEXT_MODEL=
NINEROUTER_IMAGE_MODEL=
# 9Router TTS model IDs may include a final voice segment. Copy from your router.
NINEROUTER_AUDIO_MODEL=
NINEROUTER_VOICE=
# Optional comma-separated exact HTTP origins approved by the administrator.
# Only public IPv4 origins qualify. Private/local addresses remain forbidden.
# HTTP sends prompts, media, and API credentials without transport encryption.
NINEROUTER_ALLOWED_HTTP_ORIGINS=

# Server-only 32-byte random key encoded as 64 hex characters for the per-account
# AES-GCM credential vault. Configure as a runtime secret, never a public variable.
STUDIO_CREDENTIAL_ENCRYPTION_KEY=

# Server-only comma-separated verified Sites user IDs allowed to change global
# prompt instructions through MCP. Empty means no administrator; never use emails.
STUDIO_ADMIN_USER_IDS=
